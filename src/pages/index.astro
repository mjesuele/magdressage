---
import ActionLink from '../components/ActionLink.astro';
import InquiryStrip from '../components/InquiryStrip.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { inquiryLabel, location, pages } from '../content/site';
import SiteLayout from '../layouts/SiteLayout.astro';

const featured = [
  { page: pages.about, label: 'About Maia', photo: 'about-maia-with-milena', tone: 'clay' },
  { page: pages.training, label: 'Board & Training', photo: 'training-maia-teaching', tone: 'stone' },
  { page: pages.facility, label: 'The Facility', photo: 'facility-indoor-arena', tone: 'chalk' },
] as const;
---

<SiteLayout page="home">
  <div class="hero">
    <PhotoFrame
      slotName="home-maia-riding-milena"
      sizes="100vw"
      ratio="2 / 1"
      mobileRatio="1 / 1"
      priority
    />
  </div>

  <div class="shell overview">
    <section class="introduction" aria-labelledby="home-title">
      <p class="place-label">{location}</p>
      <h1 id="home-title">Welcome to<br /> MAG Dressage</h1>
      <div class="intro-copy">
        <p class="intro-lead">Based at Comfortside Farm in northern Westchester County, MAG Dressage is a boutique dressage training program dedicated to the development of horses and riders.</p>
        <div class="prose">
          <p>Founded by FEI rider and USDF Silver Medalist Maia Gromadowski, MAG Dressage offers individualized training for developing horses, ambitious amateur riders, and competitive dressage partnerships.</p>
          <p>With an emphasis on correct fundamentals, thoughtful horsemanship, and continued education, our program provides a supportive yet goal-oriented environment where horses and riders can reach their potential.</p>
          <p>From daily training and instruction to clinics and competition, MAG Dressage is committed to achieving excellence while enjoying the journey.</p>
        </div>
      </div>
      <div class="intro-inquiry">
        <ActionLink href={pages.contact.href}>{inquiryLabel}</ActionLink>
      </div>
    </section>

    <nav aria-label="Explore MAG Dressage">
      <ul class="feature-links">
        {featured.map(({ page, label, photo, tone }) => (
          <li>
            <PhotoFrame slotName={photo} {tone} sizes="(max-width: 688px) 90vw, (max-width: 1351px) 29vw, 390px" />
            <a class="feature-link" href={page.href}>
              <span class="feature-link-title">{label}</span>
              <span class="feature-arrow" aria-hidden="true">⟶</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <InquiryStrip
    heading="Interested in joining our full-training program?"
    text="Tell us about your horse and your goals."
  />
</SiteLayout>

<style>
  .hero {
    --photo-max-height: max(30vw, 62svh);
  }

  .overview {
    padding-block: clamp(1.5rem, 3.4vw, 3rem) var(--section-space);
  }

  .introduction {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    align-items: start;
    column-gap: clamp(1rem, 5vw, 5rem);
    padding-bottom: clamp(2.5rem, 5.5vw, 4.5rem);
  }

  .introduction .place-label {
    grid-column: 1 / -1;
    margin-bottom: 0.65rem;
  }

  .introduction h1 {
    font-size: clamp(2.375rem, 4.25vw, 3.5rem);
    line-height: 1;
  }

  .intro-copy {
    grid-column: 2;
    grid-row: 2 / span 2;
  }

  .intro-lead {
    max-width: 52ch;
    margin-bottom: 1.35rem;
    font-size: 1.1875rem;
    line-height: 1.45;
  }

  .intro-inquiry {
    margin-top: 0.9rem;
  }

  .feature-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.05rem, 2.2vw, 1.8rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-link:hover > .feature-link-title {
    text-decoration: underline var(--color-brand-red);
    text-underline-offset: 0.2em;
  }

  .feature-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.65rem;
    padding-block: 0.8rem 0.65rem;
    border-bottom: 1px solid var(--rule);
    font: 600 clamp(1.65rem, 2.7vw, 2.25rem)/1.05 var(--serif);
    text-decoration: none;
  }

  .feature-arrow {
    display: inline-block;
    color: var(--color-brand-red);
    font: 500 1.2rem/1 var(--sans);
  }

  @media (max-width: 43rem) {
    .hero {
      --photo-max-height: max(92vw, 62svh);
    }

    .introduction {
      display: block;
    }

    .introduction .place-label {
      margin-bottom: 0.85rem;
    }

    .introduction h1 {
      margin-bottom: 0.9rem;
    }

    .intro-inquiry {
      margin-top: 1.25rem;
    }

    .feature-links {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.7rem;
    }
  }
</style>
