---
import PhotoViewer from '../components/PhotoViewer.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { pages, siteName, type Page } from '../content/site';
import '../styles/site.css';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { title, description, href } = pages[page];
const canonical = new URL(href, Astro.site);
const socialImage = new URL('/social-preview.jpg', Astro.site);
const isIndexable = import.meta.env.PROD && process.env.MAG_SITE_INDEXABLE === 'true'
  && (!process.env.CF_PAGES || process.env.CF_PAGES_BRANCH === 'main');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!isIndexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/cormorant-garamond.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MAG Dressage logo, North Salem, New York" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <SiteHeader currentPage={page} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <PhotoViewer />
  </body>
</html>
