---
interface Props {
  href: string;
  variant?: 'button' | 'text';
}

const { href, variant = 'button' } = Astro.props;
---

<a class:list={['action', variant]} href={href}>
  <span class="label"><slot /></span>
  <span class="arrow" aria-hidden="true">⟶</span>
</a>

<style>
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: fit-content;
    min-height: 2.875rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .button {
    padding: 0.9rem 1.15rem;
    background: var(--ink);
    box-shadow: inset 0 -2px var(--color-brand-red);
    color: var(--white);
  }

  .button:hover {
    background: #383330;
  }

  .text {
    color: var(--ink);
  }

  .text .label {
    text-decoration: underline;
    text-underline-offset: 0.24em;
  }

  .text:hover .label {
    text-decoration-color: var(--color-brand-red);
    text-decoration-thickness: 2px;
  }

  .arrow {
    font-size: 1.2em;
    line-height: 1;
  }
</style>
